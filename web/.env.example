# Copy to .env and fill with your own values.
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/angeles_store
ADMIN_EMAIL=admin@example.com
# Production requires 12+ characters. Never commit the real value.
ADMIN_PASSWORD=replace-this-with-a-real-password
# Public store domain. Used by canonical URLs and WhatsApp previews.
SITE_URL=https://angelesstore.styledflow.com
# Real business WhatsApp. 8 local digits or 11 including 504.
STORE_WHATSAPP=50499998888
# Keep false for an empty production store. Set true to load the demo catalog.
SEED_PRODUCTS=false

# Cloudflare R2. Create an API token with Object Read & Write for the bucket.
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=angeles-store
# Public image domain. Cloudflare Access must be disabled on this hostname.
R2_PUBLIC_URL=https://angelesfile.styledflow.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
