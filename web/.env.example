# Copy to .env and fill with your own values.
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/angeles_store
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please
SITE_URL=https://your-domain.com

# Cloudflare R2. Create an API token with Object Read & Write for the bucket.
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=angeles-store
R2_PUBLIC_URL=https://pub-<hash>.r2.dev
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
